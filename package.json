{
  "name": "agent-permissions-spec",
  "version": "0.1.0",
  "description": "Cross-agent permission policy specification for AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "agent-permissions.schema.json"
  ],
  "scripts": {
    "build:schema": "node --experimental-strip-types src/build-schema.ts",
    "build": "tsc && pnpm build:schema",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "agents",
    "permissions",
    "ai",
    "coding-agent",
    "claude-code",
    "cross-agent",
    "policy"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
