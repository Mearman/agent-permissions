{
  "$schema": "./agent-permissions.schema.json",
  "defaultMode": "standard",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Read",
      "Grep",
      "WebFetch(domain:docs.example.com)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo:*)",
      "Bash(curl * | bash)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Write(./production/**)"
    ],
    "additionalDirectories": [
      "../shared-libs/",
      "/tmp/build-cache"
    ]
  },
  "rules": [
    {
      "tool": "Bash",
      "pattern": "npm run *",
      "tier": "allow",
      "when": { "cwd": "./packages/*" }
    },
    {
      "tool": "Write",
      "pattern": "./config/**",
      "tier": "ask",
      "when": { "branch": "main" }
    }
  ],
  "delegation": {
    "maxDepth": 2,
    "nonDelegable": [
      "Bash(sudo:*)",
      "Write(./.agents/**)"
    ],
    "bubbleUp": true
  },
  "env": {
    "NODE_ENV": "development",
    "DISABLE_TELEMETRY": "1"
  }
}
