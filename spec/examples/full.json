{
  "$schema": "./agent-permissions.schema.json",
  "defaultMode": "standard",
  "activeProfile": "development",
  "rules": [
    { "tool": "Bash", "pattern": "git status", "tier": "allow" },
    { "tool": "Bash", "pattern": "git log:*", "tier": "allow" },
    { "tool": "Bash", "pattern": "git diff:*", "tier": "allow" },
    { "tool": "Bash", "pattern": "npm run lint", "tier": "allow" },
    { "tool": "Bash", "pattern": "npm run test:*", "tier": "allow" },
    { "tool": "Read", "tier": "allow" },
    { "tool": "Grep", "tier": "allow" },
    { "tool": "WebFetch", "pattern": "domain:docs.example.com", "tier": "allow" },
    { "tool": "Bash", "pattern": "rm -rf /", "tier": "deny" },
    { "tool": "Bash", "pattern": "sudo:*", "tier": "deny" },
    { "tool": "Bash", "pattern": "curl * | bash", "tier": "deny" },
    { "tool": "Bash", "pattern": "git push --force:*", "tier": "deny" },
    { "tool": "Read", "pattern": "./.env", "tier": "deny" },
    { "tool": "Read", "pattern": "./secrets/**", "tier": "deny" },
    { "tool": "Bash", "pattern": "npm publish:*", "tier": "deny" },
    { "tool": "Bash", "pattern": "git push:*", "tier": "ask" },
    { "tool": "Write", "pattern": "./production/**", "tier": "ask" },
    { "tool": "Bash", "pattern": "npm run *", "tier": "allow", "when": { "cwd": "./packages/*" } },
    { "tool": "Write", "pattern": "./config/**", "tier": "ask", "when": { "branch": "main" } }
  ],
  "profiles": {
    "development": {
      "allow": [
        "Read",
        "Write",
        "Edit",
        "Bash(git:*)",
        "Bash(npm:*)",
        "Grep",
        "Glob"
      ],
      "deny": [
        "Bash(sudo:*)",
        "Bash(rm -rf /)"
      ]
    },
    "review": {
      "allow": ["Read", "Grep", "Glob", "Bash(git diff:*)", "Bash(git log:*)"],
      "deny": ["Write", "Edit", "Bash"]
    },
    "ci": {
      "allow": [
        "Read",
        "Write",
        "Edit",
        "Bash(npm run:*)",
        "Bash(git checkout:*)"
      ],
      "deny": ["Bash(sudo:*)"],
      "defaultMode": "autonomous"
    }
  },
  "delegation": {
    "maxDepth": 2,
    "nonDelegable": [
      "Bash(sudo:*)",
      "Write(./.agents/**)"
    ],
    "bubbleUp": true,
    "agents": {
      "review": {
        "deny": ["Write", "Edit", "Bash"],
        "allow": ["Read", "Grep"]
      },
      "docs": {
        "allow": ["Read", "Write(./docs/**)", "Bash(mdbook build:*)"]
      }
    }
  },
  "sandbox": {
    "mode": "workspace-write",
    "writableRoots": ["/tmp/build-cache"],
    "networkAccess": true
  },
  "network": {
    "enabled": true,
    "domains": {
      "api.example.com": "allow",
      "evil.com": "deny"
    }
  },
  "env": {
    "NODE_ENV": "development",
    "DISABLE_TELEMETRY": "1"
  }
}
