{
  "$schema": "./agent-permissions.schema.json",
  "defaultMode": "standard",
  "activeProfile": "development",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Read",
      "Grep",
      "WebFetch(domain:docs.example.com)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo:*)",
      "Bash(curl * | bash)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Write(./production/**)"
    ],
    "additionalDirectories": [
      "../shared-libs/",
      "/tmp/build-cache"
    ]
  },
  "rules": [
    {
      "tool": "Bash",
      "pattern": "npm run *",
      "tier": "allow",
      "when": { "cwd": "./packages/*" }
    },
    {
      "tool": "Write",
      "pattern": "./config/**",
      "tier": "ask",
      "when": { "branch": "main" }
    }
  ],
  "profiles": {
    "development": {
      "allow": [
        "Read",
        "Write",
        "Edit",
        "Bash(git:*)",
        "Bash(npm:*)",
        "Grep",
        "Glob"
      ],
      "deny": [
        "Bash(sudo:*)",
        "Bash(rm -rf /)"
      ]
    },
    "review": {
      "allow": ["Read", "Grep", "Glob", "Bash(git diff:*)", "Bash(git log:*)"],
      "deny": ["Write", "Edit", "Bash"]
    },
    "ci": {
      "allow": [
        "Read",
        "Write",
        "Edit",
        "Bash(npm run:*)",
        "Bash(git checkout:*)"
      ],
      "deny": ["Bash(sudo:*)"],
      "defaultMode": "autonomous"
    }
  },
  "delegation": {
    "maxDepth": 2,
    "nonDelegable": [
      "Bash(sudo:*)",
      "Write(./.agents/**)"
    ],
    "bubbleUp": true,
    "agents": {
      "review": {
        "deny": ["Write", "Edit", "Bash"],
        "allow": ["Read", "Grep"]
      },
      "docs": {
        "allow": ["Read", "Write(./docs/**)", "Bash(mdbook build:*)"]
      }
    }
  },
  "sandbox": {
    "mode": "workspace-write",
    "writableRoots": ["/tmp/build-cache"],
    "networkAccess": true
  },
  "network": {
    "enabled": true,
    "domains": {
      "api.example.com": "allow",
      "evil.com": "deny"
    }
  },
  "env": {
    "NODE_ENV": "development",
    "DISABLE_TELEMETRY": "1"
  }
}
