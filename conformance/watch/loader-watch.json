          "reports": [
            {
              "error": {
                "message": ["permissions.json"]
              }
            }
          ]
        },
        {
          "files": {
            "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"ask\"}]}"
          },
          "reports": [
            {
              "decisions": [["Bash", "rm x", "ask"]]
            }
          ]
        }
      ]
    },
