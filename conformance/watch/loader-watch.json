    {
      "id": "loader-watch.004",
      "from": "loader-watch.test.ts: watchPolicy > reports a file it cannot read, and does not report a policy without it",
      "kind": "watch",
      "cwd": "$DIR0",
      "files": {
        "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}"
      },
      "steps": [
        {
          "reports": [
            {
              "decisions": [["Bash", "rm x", "deny"]]
            }
          ]
        },
        {
          "files": {
            "$DIR0/.agents/permissions.json": "{ not json"
