      "from": "loader-watch.test.ts: watchPolicy > reports the new policy when a layer file changes",
      "kind": "watch",
      "cwd": "$DIR0",
      "files": {
        "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"git:*\",\"tier\":\"allow\"}]}"
      },
      "steps": [
        {
          "reports": [
            {
              "decisions": [["Bash", "git status", "allow"]]
            }
          ]
        },
        {
          "files": {
            "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"git:*\",\"tier\":\"allow\"},{\"tool\":\"Bash\",\"pattern\":\"git push:*\",\"tier\":\"deny\"}]}"
          },
          "reports": [
            {
              "decisions": [["Bash", "git push origin", "deny"]]
            }
          ]
        }
      ]
    },
