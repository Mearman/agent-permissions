      "module": "sync",
      "function": "sync",
      "args": [
        {
          "cwd": "$DIR0/app",
          "up": {
            "$number": "Infinity"
          },
          "with": [],
          "without": [],
          "yes": true,
          "dryRun": false,
          "create": true,
          "verbose": false,
          "backup": false,
          "ompAgentDir": "$DIR1/no-omp-agent",
          "ompGlobal": false
        }
      ],
      "stderr": {
        "includes": ["warning: ", "opencode.json", "not valid UTF-8"]
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{}",
