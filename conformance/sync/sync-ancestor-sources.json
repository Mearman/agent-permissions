    {
      "id": "sync-ancestor-sources.006",
      "from": "sync-ancestor-sources.test.ts: a warning about a source is reported once per change of that file > repeats only when the file's content changes",
      "kind": "steps",
      "files": {
        "$DIR0/.agents/permissions.json": "{}",
        "$DIR0/app/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"allow\":\"Read\"}}"
      },
      "steps": [
        {
          "module": "sync",
          "function": "sync",
          "args": [
            {
              "cwd": "$DIR0/app",
              "up": {
                "$number": "Infinity"
              },
              "with": [],
              "without": [],
              "yes": true,
              "dryRun": false,
              "create": false,
              "verbose": false,
              "backup": false,
              "ompAgentDir": "$DIR1/no-omp-agent",
              "ompGlobal": false,
              "warned": {
                "$map": [],
                "as": "warned"
              }
            }
          ],
          "stderr": {
            "includes": ["warning: ", "$DIR0/.claude/settings.json"]
          },
          "checks": [
            {
              "at": ["applied"],
              "present": true
            }
          ]
        },
        {
          "module": "sync",
          "function": "sync",
          "args": [
            {
              "cwd": "$DIR0/app",
              "up": {
                "$number": "Infinity"
              },
              "with": [],
              "without": [],
              "yes": true,
              "dryRun": false,
              "create": false,
              "verbose": false,
              "backup": false,
              "ompAgentDir": "$DIR1/no-omp-agent",
              "ompGlobal": false,
              "warned": {
                "$ref": "warned"
              }
            }
          ],
          "stderr": {
            "absent": ["warning: "]
          },
          "checks": [
            {
              "at": ["applied"],
              "present": true
            }
          ]
        },
        {
          "module": "sync",
          "function": "sync",
          "files": {
            "$DIR0/.claude/settings.json": "{\"permissions\":{\"allow\":7}}"
          },
          "args": [
            {
              "cwd": "$DIR0/app",
              "up": {
                "$number": "Infinity"
              },
              "with": [],
              "without": [],
              "yes": true,
              "dryRun": false,
              "create": false,
              "verbose": false,
              "backup": false,
              "ompAgentDir": "$DIR1/no-omp-agent",
              "ompGlobal": false,
              "warned": {
                "$ref": "warned"
              }
            }
          ],
          "stderr": {
            "includes": ["warning: ", "$DIR0/.claude/settings.json"]
          },
          "checks": [
            {
              "at": ["applied"],
              "present": true
            }
          ]
        }
      ],
      "notes": "Three syncs share one record of what was warned about; the settings file is changed before the third."
    }
  ]
}
