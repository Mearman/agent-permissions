{
  "cases": [
    {
      "id": "sync-ancestor-sources.001",
      "from": "sync-ancestor-sources.test.ts: a source that sync would not write never stops it > skips an ancestor's undecodable settings with a warning naming the file and the reason, and still writes",
      "kind": "function",
      "module": "sync",
      "function": "sync",
      "args": [
        {
          "cwd": "$DIR0/app",
          "up": {
            "$number": "Infinity"
          },
          "with": [],
          "without": [],
          "yes": true,
          "dryRun": false,
          "create": true,
          "verbose": false,
          "backup": false,
          "ompAgentDir": "$DIR1/no-omp-agent",
          "ompGlobal": false
        }
      ],
      "stderr": {
        "includes": ["warning: ", "$DIR0/.claude/settings.json", "allow"]
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{}",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"allow\":\"Read\"}}",
        "$DIR0/app/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}",
        "$DIR0/app/.claude/settings.json": "{\"model\": \"x\"}\n"
      },
      "expectFiles": {
        "$DIR0/app/.claude/settings.json": "{\"model\": \"x\", \"permissions\": {\"allow\":[],\"deny\":[\"Bash(rm:*)\"],\"ask\":[]}}\n",
        "$DIR0/app/.kiro/permissions.json": "{\n  \"toolsSettings\": {\n    \"shell\": {\n      \"deniedCommands\": [\n        \"\\\\Arm:*\\\\z\"\n      ]\n    }\n  }\n}\n",
        "$DIR0/app/.omp/config.yml": "bash:\n  patterns:\n    - match: rm\n      approval: deny\n    - match: rm *\n      approval: deny\n",
        "$DIR0/app/opencode.json": "{\n  \"permission\": {\n    \"bash\": {\n      \"rm *\": \"deny\"\n    }\n  }\n}\n"
      }
    },
    {
