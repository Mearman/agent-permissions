{
  "cases": [
    {
      "id": "sync-modelled-paths.001",
      "from": "sync-modelled-paths.test.ts: sync replaces only what it decoded > keeps Claude Code's other permissions keys, and the deny rule beside them",
      "kind": "function",
      "module": "sync",
      "function": "sync",
      "args": [
        {
          "cwd": "$DIR0",
          "up": 0,
          "with": [],
          "without": [],
          "yes": true,
          "dryRun": false,
          "create": true,
          "verbose": false,
          "backup": false,
          "ompAgentDir": "$DIR1/no-omp-agent",
          "ompGlobal": false
        }
      ],
      "expect": {
        "changes": [
          {
            "path": "$DIR0/.agents/permissions.json",
            "agent": "canonical",
            "kind": "update",
            "current": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"}]}",
            "proposed": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"},{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}"
          },
          {
            "path": "$DIR0/.claude/settings.json",
            "agent": "claude-code",
            "kind": "update",
            "current": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"disableBypassPermissionsMode\":\"disable\"},\"model\":\"opus\"}",
            "proposed": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"disableBypassPermissionsMode\":\"disable\",\"allow\":[\"Read\"],\"ask\":[]},\"model\":\"opus\"}"
          },
          {
            "path": "$DIR0/.kiro/permissions.json",
            "agent": "kiro",
            "kind": "create",
            "current": null,
            "proposed": "{\n  \"allowedTools\": [\n    \"read\"\n  ],\n  \"toolsSettings\": {\n    \"shell\": {\n      \"deniedCommands\": [\n        \"\\\\Arm:*\\\\z\"\n      ]\n    }\n  }\n}\n"
          },
          {
            "path": "$DIR0/opencode.json",
            "agent": "opencode",
            "kind": "create",
            "current": null,
            "proposed": "{\n  \"permission\": {\n    \"read\": \"allow\",\n    \"bash\": {\n      \"rm *\": \"deny\"\n    }\n  }\n}\n"
          },
          {
            "path": "$DIR0/.omp/config.yml",
            "agent": "omp",
            "kind": "create",
            "current": null,
            "proposed": "bash:\n  patterns:\n    - match: rm\n      approval: deny\n    - match: rm *\n      approval: deny\n"
          }
        ],
        "applied": true,
        "refused": [],
        "aborted": false
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"}]}",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"disableBypassPermissionsMode\":\"disable\"},\"model\":\"opus\"}"
      },
      "expectFiles": {
        "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"},{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"disableBypassPermissionsMode\":\"disable\",\"allow\":[\"Read\"],\"ask\":[]},\"model\":\"opus\"}",
        "$DIR0/.kiro/permissions.json": "{\n  \"allowedTools\": [\n    \"read\"\n  ],\n  \"toolsSettings\": {\n    \"shell\": {\n      \"deniedCommands\": [\n        \"\\\\Arm:*\\\\z\"\n      ]\n    }\n  }\n}\n",
        "$DIR0/.omp/config.yml": "bash:\n  patterns:\n    - match: rm\n      approval: deny\n    - match: rm *\n      approval: deny\n",
        "$DIR0/opencode.json": "{\n  \"permission\": {\n    \"read\": \"allow\",\n    \"bash\": {\n      \"rm *\": \"deny\"\n    }\n  }\n}\n"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
