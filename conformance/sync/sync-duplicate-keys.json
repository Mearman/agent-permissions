{
  "cases": [
    {
      "id": "sync-duplicate-keys.001",
      "from": "sync-duplicate-keys.test.ts: a duplicate key on an edited path is refused > when the object holding the permissions appears twice",
      "kind": "function",
      "module": "sync",
      "function": "sync",
      "args": [
        {
          "cwd": "$DIR0",
          "up": 0,
          "with": [],
          "without": [],
          "yes": true,
          "dryRun": false,
          "create": true,
          "verbose": false,
          "backup": false,
          "ompAgentDir": "$DIR1/no-omp-agent",
          "ompGlobal": false
        }
      ],
      "throws": {
        "name": "SyncRefusedError",
        "message": ["permissions", "at 1:2 and 1:35"],
        "checks": [
          {
            "at": ["path"],
            "subset": "$DIR0/.claude/settings.json"
          },
          {
            "at": ["reason"],
            "subset": "duplicate-key"
          }
        ]
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"rm:*\",\"tier\":\"deny\"}]}",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"allow\":[\"Read\"]},\"permissions\":{\"allow\":[\"Read\"]}}"
      }
    },
