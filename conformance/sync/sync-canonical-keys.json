      "kind": "function",
      "module": "sync",
      "function": "sync",
      "args": [
        {
          "cwd": "$DIR0",
          "up": 0,
          "with": [],
          "without": [],
          "yes": true,
          "dryRun": false,
          "create": false,
          "verbose": false,
          "backup": false,
          "ompAgentDir": "$DIR1/no-omp-agent",
          "ompGlobal": false
        }
      ],
      "expect": {
        "changes": [
          {
            "path": "$DIR0/.agents/permissions.json",
            "agent": "canonical",
            "kind": "update",
            "current": "{\n    \"$schema\":   \"https://example.com/schema.json\",\n    \"ceiling\":   true,\n    \"with\":   [\"claude-code\", \"opencode\"],\n    \"up\":   3,\n    \"sync\":   {\"mode\": \"watch\",   \"backup\": true},\n    \"rules\": []\n}\n",
            "proposed": "{\n    \"$schema\":   \"https://example.com/schema.json\",\n    \"ceiling\":   true,\n    \"with\":   [\"claude-code\", \"opencode\"],\n    \"up\":   3,\n    \"sync\":   {\"mode\": \"watch\",   \"backup\": true},\n    \"rules\": [\n        {\n            \"tool\": \"Bash\",\n            \"pattern\": \"rm:*\",\n            \"tier\": \"deny\"\n        }\n    ]\n}\n"
          },
          {
            "path": "$DIR0/.claude/settings.json",
            "agent": "claude-code",
            "kind": "update",
            "current": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"]}}",
            "proposed": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"allow\":[],\"ask\":[]}}"
          }
        ],
        "applied": true,
        "refused": [],
        "aborted": false
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{\n    \"$schema\":   \"https://example.com/schema.json\",\n    \"ceiling\":   true,\n    \"with\":   [\"claude-code\", \"opencode\"],\n    \"up\":   3,\n    \"sync\":   {\"mode\": \"watch\",   \"backup\": true},\n    \"rules\": []\n}\n",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"]}}"
      },
      "expectFiles": {
        "$DIR0/.agents/permissions.json": "{\n    \"$schema\":   \"https://example.com/schema.json\",\n    \"ceiling\":   true,\n    \"with\":   [\"claude-code\", \"opencode\"],\n    \"up\":   3,\n    \"sync\":   {\"mode\": \"watch\",   \"backup\": true},\n    \"rules\": [\n        {\n            \"tool\": \"Bash\",\n            \"pattern\": \"rm:*\",\n            \"tier\": \"deny\"\n        }\n    ]\n}\n",
        "$DIR0/.claude/settings.json": "{\"permissions\":{\"deny\":[\"Bash(rm:*)\"],\"allow\":[],\"ask\":[]}}"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
