{
  "cases": [
    {
      "id": "claude-code-compat.001",
      "from": "claude-code-compat.test.ts: Claude Code compatibility > real settings.json permissions > accepts the full permissions block from a real .claude/settings.json",
      "kind": "function",
      "module": "schema",
      "function": "AgentPermissionPolicy.safeParse",
      "args": [
        {
          "permissions": {
            "allow": [
              "Bash(du:*)",
              "Bash(python3:*)",
              "Bash(claude plugin:*)",
              "Bash(*rm* -rf */cache/*)"
            ],
            "deny": ["Bash(*rm* /)", "Bash(sudo *rm*)", "Bash(git add -A*)"],
            "ask": ["Bash(*rm\\* -r*)", "Write(eslint.config.ts)"],
            "defaultMode": "dontAsk"
          }
        }
      ],
      "checks": [
        {
          "at": ["success"],
          "equals": true
        }
      ]
    },
    {
