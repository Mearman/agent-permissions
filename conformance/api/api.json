      "id": "api.032",
      "from": "api.test.ts: check explanation > returns the steps behind the decision",
      "kind": "function",
      "module": "api",
      "function": "check",
      "args": [
        "Bash",
        "git status && rm x",
        {
          "rules": [
            {
              "tool": "Bash",
              "pattern": "git:*",
              "tier": "allow"
            },
            {
              "tool": "Bash",
              "pattern": "rm:*",
              "tier": "ask"
            }
          ]
        },
        {}
      ],
      "expect": {
        "decision": "ask",
        "steps": [
          {
            "command": "git status",
            "decision": "allow",
            "reason": "rule",
            "rule": {
              "tool": "Bash",
              "pattern": "git:*",
              "tier": "allow"
            }
          },
          {
            "command": "rm x",
            "decision": "ask",
            "reason": "rule",
            "rule": {
              "tool": "Bash",
              "pattern": "rm:*",
              "tier": "ask"
            }
          }
        ],
        "hidden": false
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
