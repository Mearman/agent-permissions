    {
      "id": "api.024",
      "from": "api.test.ts: convert > converts claude-code to canonical with auto-detect",
      "kind": "function",
      "module": "api",
      "function": "convert",
      "args": [
        {
          "$undefined": true
        },
        "canonical",
        {
          "allow": ["Read"],
          "deny": ["Bash(sudo:*)"]
        }
      ],
      "expect": {
        "output": {
          "$schema": "https://github.com/ExaDev/agent-permissions/releases/latest/download/agent-permissions.schema.json",
          "rules": [
            {
              "tool": "Bash",
              "pattern": "sudo:*",
              "tier": "deny"
            },
            {
              "tool": "Read",
              "tier": "allow"
            }
          ]
        },
        "from": "claude-code",
        "ruleCount": 2,
        "companions": []
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
