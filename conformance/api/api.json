      "id": "api.038",
      "from": "api.test.ts: convert to Codex > fails instead of dropping a command rule it cannot enforce",
      "kind": "function",
      "module": "api",
      "function": "convert",
      "args": [
        "canonical",
        "codex",
        {
          "rules": [
            {
              "tool": "Bash",
              "pattern": "git * --force",
              "tier": "ask"
            }
          ]
        }
      ],
      "throws": {
        "name": "UnsupportedCapabilityError",
        "checks": [
          {
            "at": ["agent"],
            "subset": "codex"
          },
          {
            "at": ["unsupported"],
            "subset": [
              {
                "rule": {
                  "tool": "Bash",
                  "pattern": "git * --force",
                  "tier": "ask"
                }
              }
            ]
          },
          {
            "at": ["unsupported", 0, "rule"],
            "equals": {
              "tool": "Bash",
              "pattern": "git * --force",
              "tier": "ask"
            }
          },
          {
            "at": ["settings"],
            "subset": []
          }
        ]
      }
    },
