      ],
      "expect": [""]
    },
    {
      "id": "prompt-tool.007",
      "from": "prompt-tool.test.ts: toolSubjects > has no subject when the field the tool is judged by is missing",
      "kind": "function",
      "module": "prompt-tool",
      "function": "toolSubjects",
      "args": [
        "Bash",
        {
          "description": "x"
        },
        "/work/project"
      ],
      "expectUndefined": true
    },
    {
      "id": "prompt-tool.008",
      "from": "prompt-tool.test.ts: promptToolContent > wraps the result as one JSON text block",
      "kind": "function",
      "module": "prompt-tool",
      "function": "promptToolContent",
      "args": [
        {
          "behavior": "deny",
          "message": "no"
        }
      ],
      "expect": {
        "content": [
          {
            "type": "text",
            "text": "{\"behavior\":\"deny\",\"message\":\"no\"}"
          }
        ]
      }
    },
    {
      "id": "prompt-tool.009",
      "from": "prompt-tool.test.ts: createPermissionPrompt > allows a call the policy allows, echoing its input",
      "kind": "prompt",
      "policy": {
        "defaultMode": "standard",
        "rules": [
          {
            "tool": "Bash",
            "pattern": "sudo:*",
            "tier": "deny"
          },
          {
            "tool": "Bash",
            "pattern": "git push:*",
            "tier": "ask"
          },
          {
            "tool": "Bash",
            "pattern": "git:*",
            "tier": "allow"
          },
          {
            "tool": "Read",
            "pattern": "./.env",
            "tier": "deny"
          },
          {
            "tool": "Read",
            "tier": "allow"
          },
          {
            "tool": "Bash",
            "pattern": "npm publish:*",
            "tier": "allow",
            "when": {
              "branch": "main"
            }
          }
        ]
      },
      "root": "/work/project",
      "request": {
        "tool_name": "Bash",
        "input": {
          "command": "git status",
          "description": "status"
        }
      },
      "expect": {
        "behavior": "allow",
        "updatedInput": {
          "command": "git status",
          "description": "status"
        }
      }
    },
    {
      "id": "prompt-tool.010",
      "from": "prompt-tool.test.ts: createPermissionPrompt > denies a call the policy denies, naming the rule",
      "kind": "prompt",
      "policy": {
        "defaultMode": "standard",
        "rules": [
          {
            "tool": "Bash",
            "pattern": "sudo:*",
            "tier": "deny"
          },
