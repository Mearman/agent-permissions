    {
      "id": "prompt-tool.012",
      "from": "prompt-tool.test.ts: createPermissionPrompt > applies a file rule written as an absolute path",
      "kind": "prompt",
      "policy": {
        "defaultMode": "restricted",
        "rules": [
          {
            "tool": "Edit",
            "pattern": "/work/project/*",
            "tier": "allow"
          }
        ]
      },
      "root": "/work/project",
      "request": {
        "tool_name": "Edit",
        "input": {
          "file_path": "/work/project/src/a.ts"
        }
      },
      "expect": {
        "behavior": "allow",
        "updatedInput": {
          "file_path": "/work/project/src/a.ts"
        }
      }
    },
    {
      "id": "prompt-tool.013",
      "from": "prompt-tool.test.ts: createPermissionPrompt > lets a rule on either path form deny what the other allows",
      "kind": "prompt",
      "policy": {
        "defaultMode": "standard",
        "rules": [
          {
            "tool": "Read",
            "pattern": "/work/project/*",
            "tier": "allow"
          },
          {
            "tool": "Read",
            "pattern": "./secrets/*",
            "tier": "deny"
          }
        ]
      },
      "root": "/work/project",
      "request": {
        "tool_name": "Read",
        "input": {
          "file_path": "/work/project/secrets/key"
        }
      },
      "expect": {
        "behavior": "deny",
        "messageIncludes": ["./secrets/key (Read(./secrets/*) [deny])"]
      }
    },
