          },
          {
            "tool": "Read",
            "tier": "allow"
          },
          {
            "tool": "Bash",
            "pattern": "npm publish:*",
            "tier": "allow",
            "when": {
              "branch": "main"
            }
          }
        ]
      },
      "root": "/work/project",
      "request": {
        "tool_name": "Bash",
        "input": {
          "command": "sudo rm -rf /"
        }
      },
      "expect": {
        "behavior": "deny",
        "messageIncludes": ["sudo rm -rf /", "Bash(sudo:*) [deny]"]
      }
    },
