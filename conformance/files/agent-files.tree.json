{
  "cases": [
    {
      "id": "agent-files.tree.001",
      "from": "agent-files.test.ts: agent-files > findDefaultFile > finds file in current directory",
      "kind": "function",
      "module": "agent-files",
      "function": "findDefaultFile",
      "args": ["canonical", "$DIR0"],
      "expect": "$DIR0/.agents/permissions.json",
      "files": {
        "$DIR0/.agents/permissions.json": "{}"
      }
    },
    {
      "id": "agent-files.tree.002",
      "from": "agent-files.test.ts: agent-files > findDefaultFile > walks up to parent directory",
      "kind": "function",
      "module": "agent-files",
      "function": "findDefaultFile",
      "args": ["canonical", "$DIR0/sub/deep"],
      "expect": "$DIR0/.agents/permissions.json",
      "files": {
        "$DIR0/.agents/permissions.json": "{}"
      }
    },
    {
      "id": "agent-files.tree.003",
      "from": "agent-files.test.ts: agent-files > findDefaultFile > returns default path when no file found",
      "kind": "function",
      "module": "agent-files",
      "function": "findDefaultFile",
      "args": ["canonical", "$DIR0/sub"],
      "expect": "$DIR0/sub/.agents/permissions.json"
    },
    {
      "id": "agent-files.tree.004",
      "from": "agent-files.test.ts: agent-files > findDefaultFile > finds claude-code settings",
      "kind": "function",
      "module": "agent-files",
      "function": "findDefaultFile",
      "args": ["claude-code", "$DIR0"],
      "expect": "$DIR0/.claude/settings.json",
      "files": {
        "$DIR0/.claude/settings.json": "{}"
      }
    },
    {
      "id": "agent-files.tree.005",
      "from": "agent-files.test.ts: agent-files > findDefaultFile > finds opencode.json",
      "kind": "function",
      "module": "agent-files",
      "function": "findDefaultFile",
      "args": ["opencode", "$DIR0"],
      "expect": "$DIR0/opencode.json",
      "files": {
        "$DIR0/opencode.json": "{}"
      }
    },
    {
      "id": "agent-files.tree.006",
      "from": "agent-files.test.ts: agent-files > writeJsonFile > writes to existing directory",
      "kind": "function",
      "module": "agent-files",
      "function": "writeJsonFile",
      "args": ["$DIR0/output.json", "{\"test\": true}"],
      "expectFiles": {
        "$DIR0/output.json": "{\"test\": true}"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
    {
      "id": "agent-files.tree.007",
      "from": "agent-files.test.ts: agent-files > writeJsonFile > creates parent directories",
      "kind": "function",
      "module": "agent-files",
      "function": "writeJsonFile",
      "args": ["$DIR0/sub/dir/output.json", "{\"nested\": true}"],
      "expectFiles": {
        "$DIR0/sub/dir/output.json": "{\"nested\": true}"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
    {
      "id": "agent-files.tree.008",
      "from": "agent-files.test.ts: agent-files > writeJsonFile > overwrites existing file",
      "kind": "function",
      "module": "agent-files",
      "function": "writeJsonFile",
      "args": ["$DIR0/output.json", "new content"],
      "files": {
        "$DIR0/output.json": "old content"
      },
      "expectFiles": {
        "$DIR0/output.json": "new content"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
    {
      "id": "agent-files.tree.009",
      "from": "agent-files.test.ts: Oh My Pi config files > takes the global config from the agent directory, preferring config.yml",
      "kind": "function",
      "module": "agent-files",
      "function": "ompGlobalConfigPath",
      "args": ["$DIR0"],
      "expect": "$DIR0/config.yml"
    },
    {
      "id": "agent-files.tree.010",
      "from": "agent-files.test.ts: Oh My Pi config files > takes the global config from the agent directory, preferring config.yml",
      "kind": "function",
      "module": "agent-files",
      "function": "ompGlobalConfigPath",
      "args": ["$DIR0"],
      "expect": "$DIR0/config.yaml",
      "files": {
        "$DIR0/config.yaml": "model: x\n"
      }
    },
    {
      "id": "agent-files.tree.011",
      "from": "agent-files.test.ts: Oh My Pi config files > takes the global config from the agent directory, preferring config.yml",
      "kind": "function",
      "module": "agent-files",
      "function": "ompGlobalConfigPath",
      "args": ["$DIR0"],
      "expect": "$DIR0/config.yml",
      "files": {
        "$DIR0/config.yaml": "model: x\n",
        "$DIR0/config.yml": "model: y\n"
      }
    }
  ]
