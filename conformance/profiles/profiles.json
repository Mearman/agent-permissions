    {
      "id": "profiles.011",
      "from": "profiles.test.ts: extends in the Codex codec > gives an extending profile its parents' restrictions",
      "kind": "function",
      "module": "compat/codecs",
      "function": "codexCodec.encode",
      "args": [
        {
          "profiles": {
            "base": {
              "deny": ["Read(./secrets)"]
            },
            "dev": {
              "extends": ["base"],
              "deny": ["WebFetch(domain:evil.com)"]
            }
          },
          "activeProfile": "dev"
        }
      ],
      "checks": [
        {
          "at": ["permissions", "dev"],
          "equals": {
            "filesystem": {
              ":workspace_roots": {
                "secrets": "deny"
              }
            },
            "network": {
              "domains": {
                "evil.com": "deny"
              }
            }
