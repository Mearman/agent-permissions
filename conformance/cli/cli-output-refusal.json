      "id": "cli-output-refusal.001",
      "from": "cli-output-refusal.test.ts: convert and confine create config files and refuse to overwrite one > convert refuses an existing .agents/permissions.json, naming it, and writes nothing",
      "kind": "cli",
      "args": [
        "convert",
        "--from",
        "$DIR0/policy.json",
        "--to",
        "canonical",
        "--output",
        "$DIR0/.agents/permissions.json"
      ],
      "cwd": "$DIR0",
      "files": {
        "$DIR0/.agents/permissions.json": "{\"sandbox\": {\"mode\": \"workspace-write\"}, \"env\": {\"A\": \"1\"}}\n",
        "$DIR0/policy.json": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"}]}"
      },
      "expect": {
        "exit": 1,
        "stderrIncludes": ["$DIR0/.agents/permissions.json", "sync"]
      },
      "expectFiles": {
        "$DIR0/.agents/permissions.json": "{\"sandbox\": {\"mode\": \"workspace-write\"}, \"env\": {\"A\": \"1\"}}\n",
        "$DIR0/policy.json": "{\"rules\":[{\"tool\":\"Read\",\"tier\":\"allow\"}]}"
