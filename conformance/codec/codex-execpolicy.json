{
  "cases": [
    {
      "id": "codex-execpolicy.001",
      "from": "codex-execpolicy.test.ts: encodeCodex writes command rules as execpolicy prefix rules > writes a prefix deny as a forbidden prefix_rule",
      "kind": "function",
      "module": "compat/codecs",
      "function": "encodeCodex",
      "args": [
        {
          "rules": [
            {
              "tool": "Bash",
              "pattern": "git push:*",
              "tier": "deny"
            }
          ]
        }
      ],
      "expect": {
        "config": {},
        "rules": "# Generated by agent-perms from a canonical permission policy.\nprefix_rule(pattern = [\"git\", \"push\"], decision = \"forbidden\")\n"
      }
    },
    {
      "id": "codex-execpolicy.002",
