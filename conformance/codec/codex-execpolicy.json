      "id": "codex-execpolicy.021",
      "from": "codex-execpolicy.test.ts: convert carries the Codex rules file > writes the rules file beside the converted config",
      "kind": "cli",
      "args": [
        "convert",
        "--from",
        "$DIR0/policy.json",
        "--to",
        "codex",
        "--output",
        "$DIR0/.codex/config.json"
      ],
      "cwd": "$DIR0",
      "files": {
        "$DIR0/policy.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"sudo:*\",\"tier\":\"ask\"}]}"
      },
      "expect": {
        "exit": 0
