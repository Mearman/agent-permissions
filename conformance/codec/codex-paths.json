      "id": "codex-paths.001",
      "from": "codex-paths.test.ts: codex codec encodes path rules where Codex reads them > puts a ./ path under :workspace_roots, not at the filesystem root",
      "kind": "function",
      "module": "compat/codecs",
      "function": "codexCodec.encode",
      "args": [
        {
          "rules": [
            {
              "tool": "Read",
              "pattern": "./secrets",
              "tier": "deny"
            }
          ]
        }
      ],
      "checks": [
        {
          "at": ["permissions", "default", "filesystem"],
          "equals": {
            ":workspace_roots": {
              "secrets": "deny"
            }
          }
        }
      ]
    },
