              "tier": "deny"
            }
          ]
        },
        "Bash",
        "git status && curl x"
      ],
      "expect": {
        "decision": "deny",
        "steps": [
          {
            "command": "git status",
            "decision": "allow",
            "reason": "rule",
            "rule": {
              "tool": "Bash",
              "pattern": "git:*",
              "tier": "allow"
            }
          },
          {
            "command": "curl x",
            "decision": "deny",
            "reason": "rule",
            "rule": {
              "tool": "Bash",
              "pattern": "curl:*",
              "tier": "deny"
            }
          }
        ],
        "hidden": false
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
