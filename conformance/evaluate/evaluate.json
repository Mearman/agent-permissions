    {
      "id": "evaluate.001",
      "from": "evaluate.test.ts: evaluate > deny-first semantics > denies when a deny rule matches, even if allow also matches",
      "kind": "evaluate",
      "policy": {
        "defaultMode": "autonomous",
        "rules": [
          {
            "tool": "Bash",
            "pattern": "rm -rf *",
            "tier": "deny"
          },
          {
            "tool": "Bash",
            "pattern": "*",
            "tier": "allow"
          }
        ]
      },
      "tool": "bash",
      "input": "rm -rf /tmp/thing",
      "expect": "deny"
    },
