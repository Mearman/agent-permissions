    {
      "id": "evaluate-env-remote.001",
      "from": "evaluate-env-remote.test.ts: when.env > applies when every named variable has the given value",
      "kind": "evaluate",
      "policy": {
        "defaultMode": "restricted",
        "rules": [
          {
            "tool": "Bash",
            "pattern": "deploy:*",
            "tier": "allow",
            "when": {
              "env": {
                "CI": "true"
              }
            }
          }
        ]
      },
      "tool": "Bash",
      "input": "deploy prod",
      "expect": "allow",
      "context": {
