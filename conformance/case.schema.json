          }
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "with": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["cwd"]
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "context": {
                "type": "object"
              },
              "expect": {
                "enum": ["allow", "ask", "deny"]
              },
              "layer": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["tool", "input", "expect"]
          }
        },
        "kind": {
          "const": "layered"
        }
      },
      "required": ["id", "from", "kind", "calls"],
      "dependentRequired": {
        "skip": ["reason"],
        "reason": ["skip"]
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["layers"],
          "properties": {
            "layers": {}
          }
        },
        {
          "type": "object",
          "required": ["load"],
          "properties": {
            "load": {}
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "skip": {
          "enum": ["ts", "rust"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
