{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ExaDev/agent-permissions/tree/main/conformance/case.schema.json",
  "title": "agent-permissions conformance corpus file",
  "description": "A corpus file: a non-empty list of cases, each of one kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Lower-case ASCII letters, digits, dots, hyphens and underscores, starting with a letter or digit; unique across the corpus (checked by every loader)."
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "`<test file>.test.ts: <describe> > <test>` or `recorded: <what>` (checked by every loader)."
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "$bytes": {
                "type": "string"
              }
            },
            "required": ["$bytes"]
          }
        ]
      },
      "description": "Files made before the case runs, by path under a `$DIRn` token; text, or `$bytes` (base64) for bytes that are not text."
    },
    "expectFiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Files as they must be afterwards: their text, or null for none."
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          }
        },
        "equals": {
          "description": "any JSON value"
        },
        "notEquals": {
          "description": "any JSON value"
        },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subset": {
          "description": "any JSON value"
        },
        "absent": {
          "const": true
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["equals"],
          "properties": {
            "equals": {}
          }
        },
        {
          "type": "object",
          "required": ["notEquals"],
          "properties": {
            "notEquals": {}
          }
        },
        {
          "type": "object",
          "required": ["contains"],
          "properties": {
            "contains": {}
          }
        },
        {
          "type": "object",
          "required": ["subset"],
          "properties": {
            "subset": {}
          }
        },
        {
          "type": "object",
          "required": ["absent"],
          "properties": {
            "absent": {}
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array"
        },
        "expect": {
          "description": "any JSON value"
        },
        "expectUndefined": {
          "const": true
        },
        "unordered": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "throws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          },
          "required": []
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "absent": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": []
        },
        "expectFiles": {
          "$ref": "#/$defs/expectFiles"
        }
      },
      "required": ["module", "function"],
      "anyOf": [
        {
          "type": "object",
          "required": ["expect"],
          "properties": {
            "expect": {}
          }
        },
        {
          "type": "object",
          "required": ["expectUndefined"],
          "properties": {
            "expectUndefined": {}
          }
        },
        {
          "type": "object",
          "required": ["checks"],
          "properties": {
            "checks": {}
          }
        },
        {
          "type": "object",
          "required": ["throws"],
          "properties": {
            "throws": {}
          }
        },
        {
          "type": "object",
          "required": ["expectFiles"],
          "properties": {
            "expectFiles": {}
          }
        },
        {
          "type": "object",
          "required": ["stderr"],
          "properties": {
            "stderr": {}
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "skip": {
          "enum": ["ts", "rust"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array"
        },
        "expect": {
          "description": "any JSON value"
        },
        "expectUndefined": {
          "const": true
        },
        "unordered": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "throws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          },
          "required": []
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "absent": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": []
        },
        "expectFiles": {
          "$ref": "#/$defs/expectFiles"
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "kind": {
          "const": "function"
        }
      },
      "required": ["id", "from", "kind", "module", "function"],
      "dependentRequired": {
        "skip": ["reason"],
        "reason": ["skip"]
      },
      "anyOf": [
        {
          "type": "object",
          "required": ["expect"],
          "properties": {
            "expect": {}
          }
        },
        {
          "type": "object",
          "required": ["expectUndefined"],
          "properties": {
            "expectUndefined": {}
          }
        },
        {
          "type": "object",
          "required": ["checks"],
          "properties": {
            "checks": {}
          }
        },
        {
          "type": "object",
          "required": ["throws"],
          "properties": {
            "throws": {}
          }
        },
        {
          "type": "object",
          "required": ["expectFiles"],
          "properties": {
            "expectFiles": {}
          }
        },
        {
          "type": "object",
          "required": ["stderr"],
          "properties": {
            "stderr": {}
          }
        }
      ]
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "skip": {
          "enum": ["ts", "rust"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "expectFiles": {
          "$ref": "#/$defs/expectFiles"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "kind": {
          "const": "steps"
        }
      },
      "required": ["id", "from", "kind", "steps"],
      "dependentRequired": {
        "skip": ["reason"],
        "reason": ["skip"]
      }
    },
    "evaluate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "skip": {
          "enum": ["ts", "rust"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object"
        },
        "tool": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "context": {
          "type": "object"
        },
        "expect": {
          "enum": ["allow", "ask", "deny"]
        },
        "kind": {
          "const": "evaluate"
        }
      },
      "required": ["id", "from", "kind", "policy", "tool", "input", "expect"],
      "dependentRequired": {
        "skip": ["reason"],
        "reason": ["skip"]
      }
    },
    "layered": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/from"
        },
        "skip": {
