  "cases": [
    {
      "id": "loader.001",
      "from": "loader.test.ts: loadPolicy > delegation limits > keeps the shallowest maxDepth and every nonDelegable rule across layers",
      "kind": "function",
      "module": "loader",
      "function": "loadPolicy",
      "args": [
        {
          "cwd": "$DIR0"
        }
      ],
      "expect": {
        "defaultMode": "standard",
        "delegation": {
          "maxDepth": 1,
          "nonDelegable": [
            {
              "tool": "Bash",
              "pattern": "sudo:*",
              "tier": "deny"
            },
            {
              "tool": "Write",
              "pattern": "./.agents/**",
              "tier": "deny"
            }
          ]
        }
      },
      "files": {
        "$DIR0/.agents/permissions.json": "{\"delegation\":{\"maxDepth\":3,\"nonDelegable\":[\"Bash(sudo:*)\"]}}",
        "$DIR0/.agents/permissions.local.json": "{\"delegation\":{\"maxDepth\":1,\"nonDelegable\":[\"Write(./.agents/**)\"]}}"
      },
      "notes": "The original asserts facts derived from the result; this case records the whole result."
    },
