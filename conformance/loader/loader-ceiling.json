      "files": {
        "$DIR0/.agents/permissions.json": "{\"ceiling\":true,\"defaultMode\":\"restricted\",\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"git:*\",\"tier\":\"allow\"},{\"tool\":\"Bash\",\"pattern\":\"curl:*\",\"tier\":\"deny\"}]}",
        "$DIR0/project/.agents/permissions.json": "{\"rules\":[{\"tool\":\"Bash\",\"pattern\":\"git status\",\"tier\":\"allow\"},{\"tool\":\"Bash\",\"pattern\":\"npm run *\",\"tier\":\"allow\"}]}"
      },
      "load": {
        "cwd": "$DIR0/project"
