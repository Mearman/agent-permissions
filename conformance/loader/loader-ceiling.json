    {
      "id": "loader-ceiling.013",
      "from": "loader-ceiling.test.ts: ceiling layers > bind through a condition that is unknown",
      "kind": "layered",
      "layers": [
        {
          "source": "org",
          "policy": {
            "ceiling": true,
            "rules": [
              {
                "tool": "Bash",
                "pattern": "git:*",
                "tier": "allow",
                "when": {
                  "branch": "main"
                }
              }
            ]
          },
          "ceiling": true
        },
        {
          "source": "repo",
          "policy": {
            "rules": [
              {
                "tool": "Bash",
                "pattern": "git status",
                "tier": "allow"
              }
            ]
          }
        }
      ],
      "calls": [
        {
          "tool": "Bash",
          "input": "git status",
          "expect": "allow",
          "context": {
            "branch": "main"
          }
        },
        {
          "tool": "Bash",
          "input": "git status",
          "expect": "ask",
          "context": {
            "branch": "dev"
          }
        },
        {
          "tool": "Bash",
          "input": "git status",
