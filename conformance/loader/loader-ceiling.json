    {
      "id": "loader-ceiling.011",
      "from": "loader-ceiling.test.ts: ceiling layers > also bound a ceiling that sits below them",
      "kind": "layered",
      "layers": [
        {
          "source": "org",
          "policy": {
            "ceiling": true,
            "defaultMode": "restricted",
            "rules": [
              {
                "tool": "Bash",
                "pattern": "git:*",
                "tier": "allow"
              },
              {
                "tool": "Bash",
                "pattern": "curl:*",
                "tier": "deny"
              }
            ]
          },
          "ceiling": true
        },
        {
          "source": "team",
          "policy": {
            "ceiling": true,
            "rules": [
              {
                "tool": "Bash",
                "pattern": "npm:*",
                "tier": "allow"
              }
            ]
          },
          "ceiling": true
        },
        {
          "source": "repo",
          "policy": {
            "rules": [
              {
                "tool": "Bash",
                "pattern": "npm run *",
                "tier": "allow"
              }
            ]
          }
        }
      ],
      "calls": [
        {
          "tool": "Bash",
          "input": "npm run build",
          "expect": "ask"
        },
        {
          "tool": "Bash",
          "input": "git status",
          "expect": "allow"
        }
      ],
      "notes": "The team's allow of npm is outside the org's ceiling, so it grants nothing, and the repo's is bounded by both."
    },
