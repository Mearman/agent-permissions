    {
      "id": "loader-ceiling.008",
      "from": "loader-ceiling.test.ts: ceiling layers > do not stop a deeper layer adding a deny or an ask",
      "kind": "layered",
      "layers": [
        {
          "source": "org",
          "policy": {
            "ceiling": true,
            "defaultMode": "restricted",
            "rules": [
              {
                "tool": "Bash",
                "pattern": "git:*",
                "tier": "allow"
              },
              {
                "tool": "Bash",
                "pattern": "curl:*",
                "tier": "deny"
              }
            ]
          },
          "ceiling": true
        },
        {
          "source": "repo",
          "policy": {
            "rules": [
              {
                "tool": "Bash",
                "pattern": "git push:*",
                "tier": "ask"
              },
              {
                "tool": "Bash",
                "pattern": "git reset:*",
                "tier": "deny"
              }
            ]
          }
        }
      ],
      "calls": [
        {
          "tool": "Bash",
          "input": "git push origin",
          "expect": "ask"
        },
        {
          "tool": "Bash",
          "input": "git reset --hard",
          "expect": "deny"
        }
      ]
    },
