{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "_typecheck": {
      "inputs": ["src/**/*.ts", "tsconfig.json"],
      "outputs": [".tsbuildinfo"]
    },
    "_lint": {
      "inputs": ["src/**/*.ts", "eslint.config.ts"],
      "outputs": [".eslintcache"]
    },
    "_lint:fix": {
      "inputs": ["src/**/*.ts", "eslint.config.ts"],
      "outputs": [".eslintcache"],
      "cache": false
    },
    "_test": {
      "dependsOn": ["_typecheck"],
      "inputs": ["src/**/*.ts"]
    },
    "_build": {
      "dependsOn": ["_typecheck", "_lint"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "tsdown.config.ts", "package.json"],
      "outputs": ["dist/**", "agent-permissions.schema.json"]
    },
    "_check": {
      "dependsOn": ["_typecheck", "_lint", "_build"]
    },
    "_validate": {
      "dependsOn": ["_check", "_test"]
    }
  }
}
