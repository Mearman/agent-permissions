{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "_build": {
      "outputs": ["dist/**"]
    },
    "_typecheck": {
      "outputs": []
    },
    "_lint": {
      "outputs": [".eslintcache"]
    },
    "_lint:fix": {
      "outputs": [".eslintcache"],
      "cache": false
    },
    "_test": {
      "dependsOn": ["_typecheck"],
      "outputs": []
    },
    "_check": {
      "dependsOn": ["_typecheck", "_lint", "_build"],
      "outputs": []
    },
    "_test:coverage": {
      "dependsOn": ["_typecheck"],
      "outputs": []
    },
    "_validate": {
      "dependsOn": ["_check", "_test"],
      "outputs": []
    }
  }
}
